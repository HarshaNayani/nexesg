# Copy to .env (never commit .env) and fill in. Export these in your shell or
# set them in the Render dashboard.

# Local development only. Leave unset (or false) in production.
DEBUG=true

# Required when DEBUG is off. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=
# Comma-separated. Render's hostname is added automatically.
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated frontend origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://breathe-esg-frontend-sp04.onrender.com

# Google Cloud Console -> Credentials -> OAuth client ID (Web application).
# This is the public Client ID only. Never put the client secret anywhere.
GOOGLE_CLIENT_ID=969817579304-k24h2k318bpl3m4eidro8jshisui0kpn.apps.googleusercontent.com


# This email is created as ADMIN on first Google login.
FIRST_ADMIN_EMAIL=harshareddynayani@gmail.com
